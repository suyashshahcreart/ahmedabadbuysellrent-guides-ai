---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/guides/</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/search/</loc><changefreq>weekly</changefreq><priority>0.5</priority></url>
  <url><loc>{{ site.url }}/about/</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  {% for cat in categories %}
  <url><loc>{{ site.url }}/{{ cat.slug }}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  {% endfor %}
  {% for item in collections.articles %}
  <url><loc>{{ item.url | absolute(site) }}</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
  {% endfor %}
  {% for item in collections.areas %}
  <url><loc>{{ item.url | absolute(site) }}</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
  {% endfor %}
</urlset>
