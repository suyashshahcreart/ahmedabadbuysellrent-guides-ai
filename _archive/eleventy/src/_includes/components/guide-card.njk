{% if variant == "featured" %}
<a class="guide-card is-featured" href="{{ item.url }}" data-searchable>
  {% if item.data.image %}
  <div class="thumb">
    <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt or item.data.title }}" loading="{{ loading or 'lazy' }}" width="960" height="540">
  </div>
  {% endif %}
  <div class="body">
    <p class="tag">{{ item.data.category | categoryLabel(categories) }}</p>
    <h3>{{ item.data.title }}</h3>
    {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
    <span class="meta">{{ (item.data.updated or item.date) | displayDate }}{% if item.data.readingTime %} · {{ item.data.readingTime }} min read{% endif %}</span>
  </div>
</a>
{% elif variant == "compact" %}
<a class="guide-card is-compact" href="{{ item.url }}" data-searchable data-item="{{ item.data.category }}">
  {% if item.data.image %}
  <div class="thumb thumb-sm">
    <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt or item.data.title }}" loading="lazy" width="144" height="96">
  </div>
  {% endif %}
  <div class="body">
    <p class="tag">{{ item.data.category | categoryLabel(categories) }}</p>
    <h3>{{ item.data.title }}</h3>
    {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
    <span class="meta">{{ (item.data.updated or item.date) | displayDate }}{% if item.data.readingTime %} · {{ item.data.readingTime }} min read{% endif %}</span>
  </div>
</a>
{% else %}
<a class="guide-card" href="{{ item.url }}" data-searchable data-item="{{ item.data.category }}">
  {% if item.data.image %}
  <div class="thumb">
    <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt or item.data.title }}" loading="{{ loading or 'lazy' }}" width="960" height="540">
  </div>
  {% endif %}
  <div class="body">
    <p class="tag">{{ item.data.category | categoryLabel(categories) }}</p>
    <h3>{{ item.data.title }}</h3>
    {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
    <span class="meta">{{ (item.data.updated or item.date) | displayDate }}{% if item.data.readingTime %} · {{ item.data.readingTime }} min read{% endif %}{% if item.data.author %} · {{ item.data.author }}{% endif %}</span>
  </div>
</a>
{% endif %}
